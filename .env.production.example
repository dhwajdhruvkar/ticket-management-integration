# Netlink Support production environment contract.
# Fill every uncommented placeholder through the deployment platform's secret
# manager. Commented provider variables are optional future capabilities.
# Never commit a populated production environment file.

# Application traffic uses Neon's pooled endpoint.
DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
DATA_DRIVER=prisma

# Required by the Prisma migration job only. Use the matching direct endpoint;
# do not inject this higher-privilege URL into the long-running app container.
DIRECT_URL=postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require

# Auth.js signing and fail-closed production mode are always required.
AUTH_SECRET=<generate-from-at-least-32-random-bytes>
DEMO_MODE=false

# Optional UI authentication. With all three values absent, browser sign-in is
# disabled and the service runs API-key-only. Configure the complete trio to
# enable Microsoft Entra ID later; partial configuration is rejected.
# AUTH_MICROSOFT_ENTRA_ID_ID=<application-client-id>
# AUTH_MICROSOFT_ENTRA_ID_SECRET=<client-secret>
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Optional private Azure Blob storage. With this absent, production attachment
# upload/download/delete operations return 503 and never use Vercel's ephemeral
# filesystem. The private container name defaults to "attachments".
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage-account>;AccountKey=<base64-account-key>;EndpointSuffix=core.windows.net

# AI, email, webhook, chat-channel, and observability variables are also
# optional capabilities and are intentionally omitted from this core contract.
