# =============================================================================
# Netlink Support — environment configuration.
#
# Copy to `.env.local` (Next.js) and/or `.env` (Prisma CLI) and fill in.
# The app runs with NONE of these set: it uses the in-memory/JSON store and the
# offline AI fallbacks. Each variable below progressively lights up a real
# production capability.
# =============================================================================

# ----- Persistence ----------------------------------------------------------
# "memory" (default, zero-infra, JSON-file persisted) or "prisma" (Postgres).
DATA_DRIVER=memory
# Postgres connection (used when DATA_DRIVER=prisma). Matches docker-compose.yml.
DATABASE_URL="postgresql://netlink:netlink@localhost:5432/netlink_support?schema=public"

# ----- LLM (answer generation) ---------------------------------------------
# Google Gemini (default). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Optional Groq fallback. Free key: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Force a provider (gemini | groq | azure-openai).
# LLM_PROVIDER=gemini

# ----- Azure OpenAI (production embeddings + chat) --------------------------
# When set, used for server-side embeddings and generation. Falls back to the
# hashed bag-of-words embedder + offline template when unset.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_API_VERSION=2024-10-21

# ----- Auth (Entra ID / Azure AD SSO) --------------------------------------
# When unset, the app uses dev credential sign-in (persona-style) for the demo.
AUTH_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ----- Security mode ---------------------------------------------------------
# Demo mode keeps the zero-infra fallbacks: passwordless demo sign-in, the
# anonymous API actor, and x-actor/x-tenant headers. It defaults to true until
# Entra ID is configured (then defaults to false). Set explicitly in production.
# DEMO_MODE=false
#
# In production mode, /api/v1 requires a session or an API key
# ("Authorization: Bearer nlk_..." — create keys in Settings -> API keys).
#
# Inbound webhook HMAC secrets. Senders sign requests with:
#   x-webhook-timestamp: <unix seconds>
#   x-webhook-signature: sha256=<hex HMAC-SHA256 of "<timestamp>.<rawBody>">
# Unsigned webhooks are allowed in demo mode, rejected in production.
# WEBHOOK_SECRET=
# ZENDESK_WEBHOOK_SECRET=
# FRESHDESK_WEBHOOK_SECRET=

# ----- Jobs / queue ---------------------------------------------------------
# The scheduler runs in-process with per-job retries and a job lock (Postgres
# advisory lock on the prisma driver, so replicas never double-run sweeps).
# Failed jobs are dead-lettered to the audit chain as job.failed.
# SCHEDULER_INTERVAL_MS=300000
# Reserved for the BullMQ upgrade path (true queue semantics on Redis):
# REDIS_URL=redis://localhost:6379

# ----- Email provider (ingestion + outbound notifications) -----------------
# Selects the email backend for BOTH inbound ingestion and outbound mail.
#   graph  -> Microsoft Graph: poll SUPPORT_MAILBOX (pull) + sendMail
#   brevo  -> Brevo: Inbound Parsing webhook (push) + transactional API
#   none   -> record-only (in-app feed; no external mail)
# Unset/auto: prefers Brevo when BREVO_API_KEY is set, else Graph when Graph is
# configured, else none.
# EMAIL_PROVIDER=auto
#
# Brevo (https://www.brevo.com). Inbound: point the support domain's MX records
# at Brevo Inbound Parsing and set the parse webhook to
# /api/webhooks/brevo?token=<BREVO_INBOUND_SECRET> (Brevo has no HMAC; the
# shared token authenticates it — required in production, optional in demo).
# Outbound: verify the sender domain in Brevo. API key downloads attachments +
# sends mail.
# BREVO_API_KEY=
# BREVO_INBOUND_SECRET=
# BREVO_SENDER=support@netlink.com   # defaults to SUPPORT_MAILBOX

# ----- Channels (omnichannel intake & notifications) -----------------------
# Microsoft Graph (M365 email + Teams). Unset = channels disabled.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# SUPPORT_MAILBOX=support@netlink.com
#
# Slack: point the app's Events API + /ticket slash command at
# /api/webhooks/slack. Inbound requests are verified with the signing secret
# (Slack v0 scheme); outbound notifications post to the incoming webhook.
# SLACK_SIGNING_SECRET=
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://...webhook.office.com/...

# ----- Storage (attachments) -----------------------------------------------
# Attachments are stored on local disk under <DATA_DIR>/attachments by default
# (mount a volume in containers). Max upload size in bytes (default 10 MB):
# ATTACHMENT_MAX_BYTES=10485760
# When set, binaries go to Azure Blob Storage instead (SharedKey REST driver):
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# ATTACHMENTS_CONTAINER=attachments

# ----- Observability --------------------------------------------------------
# SENTRY_DSN=
