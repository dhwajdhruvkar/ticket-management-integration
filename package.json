{
  "name": "netlink-support",
  "version": "1.0.0",
  "private": true,
  "description": "Netlink Support — internal IT and HR service desk for Netlink Software Group America.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run environment:check",
    "start": "next start",
    "environment:check": "node scripts/check-production-environment.cjs",
    "security:check": "node scripts/check-production-security.cjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.31",
    "pdfkit": "^0.19.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
